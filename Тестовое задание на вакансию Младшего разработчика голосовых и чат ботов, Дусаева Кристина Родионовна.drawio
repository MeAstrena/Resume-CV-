            </Array>
            <mxPoint x="289" y="870" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="UhqbLgR93CAwkpiY6Pk3-7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="К сожалению,&amp;nbsp;это время уже прошло. Давайте выберем удобное время на будущее — например, завтра в 10:00 или послезавтра в 15:00?" vertex="1">
          <mxGeometry height="143" width="120" x="31" y="512.5" as="geometry" />
        </mxCell>
        <mxCell id="UhqbLgR93CAwkpiY6Pk3-9" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="В не рабочее время" vertex="1">
