        </mxCell>
        <mxCell id="UhqbLgR93CAwkpiY6Pk3-11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="К сожалению, в это время мы не звоним. Мы работаем с [начало рабочего дня] до [конец рабочего дня]. Когда вам удобнее — утром, днём или вечером?" vertex="1">
          <mxGeometry height="147" width="120" x="102" y="683" as="geometry" />
        </mxCell>
        <mxCell id="UhqbLgR93CAwkpiY6Pk3-18" edge="1" parent="1" source="UhqbLgR93CAwkpiY6Pk3-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="UhqbLgR93CAwkpiY6Pk3-16">
